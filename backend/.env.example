# Copy to backend/.env for local development. Never commit .env files.
# Staging/production values live in Render environment settings.
# `npm run dev:full` (repo root) creates this file for you on first run.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Local PostgreSQL started by `python -m scripts.dev_db start` (no Docker needed).
# Render provides its own DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://orbit@127.0.0.1:5433/orbit_dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value-change-me

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Must be true in staging/production (HTTPS). Leave the domain empty for host-only cookies.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_EMAIL=5
LOGIN_MAX_FAILURES_PER_IP=20

COMPANY_NAME=Eranova Technologies
COMPANY_SLUG=eranova
COMPANY_TIMEZONE=Africa/Nairobi

# LOCAL ONLY: skip the sign-in screen and act as the first Super Admin.
# The API refuses to start if this is true in any other environment.
DEV_AUTO_LOGIN=false

# NOVA AI assistant. Leave NOVA_PROVIDER=none for basic (look-up only) mode.
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq, a local Ollama, ...).
NOVA_PROVIDER=none
NOVA_BASE_URL=https://api.openai.com/v1
NOVA_MODEL=
# Set the real key only in your local .env or the Render dashboard, never in git.
NOVA_API_KEY=
NOVA_TIMEOUT_SECONDS=60
NOVA_DAILY_TOKEN_LIMIT=200000
NOVA_MESSAGES_PER_MINUTE=12
# Optional, for cost estimates (USD per 1,000 tokens).
NOVA_COST_INPUT_PER_1K=
NOVA_COST_OUTPUT_PER_1K=
NOVA_RETENTION_DAYS=180
# false = NOVA masks customer emails/phones before sending context to the model.
NOVA_SHARE_CONTACT_DETAILS=false

# Integration credentials are referenced by name from Orbit, e.g.
# INTEGRATION_CRM_API_KEY=...
