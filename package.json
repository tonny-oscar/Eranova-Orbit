{
  "name": "eranova-orbit",
  "private": true,
  "description": "Convenience scripts so frontend commands also work from the repository root.",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "npm --prefix frontend run dev",
    "dev:demo": "npm --prefix frontend run dev:demo",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test",
    "test:e2e": "npm --prefix frontend run test:e2e"
  }
}
